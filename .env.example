# Copy to .env.local and fill in. Everything is optional for a local demo:
#  - no Supabase vars  → data is stored in .data/db.json, chat polls
#  - no Stripe vars    → checkout simulates a payment (dev only)

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode keys: Developers → API keys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- Admin console (/admin) ---
# Staff Google accounts (comma-separated). Signed in with one of these, /account shows
# the "Staff console" button and /admin opens without a password.
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public base URL (used for Stripe redirect URLs). Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=
